# Example environment for the app / worker / beat containers.
#
# Copy to app.env (or app.oidc.env for the OIDC variant) and fill in real values:
#   cp deploy/docker-compose/app.env.example deploy/docker-compose/app.env
#
# Both app.env and app.oidc.env are gitignored — never commit real credentials.

# ─── Database (Postgres) ─────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=marc
POSTGRES_USER=marcAdmin
POSTGRES_PASSWORD=change-me

# ─── Broker (Redis) ──────────────────────────────────────────────────────────
BROKER_HOST=redis
BROKER_PORT=6379
BROKER_DB=0

# ─── Auth ────────────────────────────────────────────────────────────────────
# SECRET_KEY must be at least 32 characters.
SECRET_KEY=replace-with-some-secret-of-length-at-least-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── Bootstrap admin ─────────────────────────────────────────────────────────
# Created on first startup if no admin exists.
ADMIN_EMAIL=admin@mzk.cz
ADMIN_FIRSTNAME=Admin
ADMIN_LASTNAME=Admin
ADMIN_PASSWORD=change-me

# ─── OIDC (optional) ─────────────────────────────────────────────────────────
# Only needed for the OIDC variant; leave OIDC_ENABLED=false to use local auth.
# OIDC_DEFAULT=true makes the IdP the default login path in the UI.
OIDC_ENABLED=false
OIDC_DEFAULT=false
OIDC_ISSUER_URL=http://keycloak:8080/realms/marc-comparator
OIDC_CLIENT_ID=marc-comparator
OIDC_CLIENT_SECRET=replace-with-your-client-secret
OIDC_APP_BASE_URL=http://localhost:8080
