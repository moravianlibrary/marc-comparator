{
    "$defs": {
        "AlephOAIConfig": {
            "description": "Configuration for accessing Aleph's OAI-PMH service.\n\nExtends the base web configuration with OAI-specific parameters such as\nthe identifier template, system number pattern, and set list.\n\nAttributes\n----------\nbase : str\n    Aleph base code (e.g., \"MZK01\") used in identifiers.\nsystem_number_pattern : str\n    Regular expression pattern for identifying system/document numbers.\noai_sets : List[str], default=[]\n    List of OAI set names to harvest from. Must contain at least one set.\noai_identifier_template : str\n    Template for generating OAI identifiers, containing `{base}` and\n    `{doc_number}` placeholders.",
            "properties": {
                "base": {
                    "title": "Base",
                    "type": "string",
                    "default": "MZK01"
                },
                "host": {
                    "title": "Host",
                    "type": "string",
                    "default": "https://aleph.mzk.cz"
                },
                "endpoint": {
                    "title": "Endpoint",
                    "type": "string",
                    "default": "OAI"
                },
                "oai_sets": {
                    "default": ["MZK01-VDK"],
                    "items": {
                        "type": "string"
                    },
                    "minItems": 1,
                    "title": "Oai Sets",
                    "type": "array"
                },
                "system_number_pattern": {
                    "title": "System Number Pattern",
                    "type": "string",
                    "default": "\\d{9}"
                },
                "oai_identifier_template": {
                    "title": "Oai Identifier Template",
                    "type": "string",
                    "default": "oai:aleph.mzk.cz:{base}-{doc_number}"
                },
                "timeout": {
                    "default": 30,
                    "title": "Timeout",
                    "type": "integer"
                },
                "total_retry": {
                    "default": 5,
                    "title": "Total Retry",
                    "type": "integer"
                },
                "retry_backoff_factor": {
                    "default": 1,
                    "title": "Retry Backoff Factor",
                    "type": "integer"
                },
                "context": {
                    "$ref": "#/$defs/MarcContext",
                    "default": {
                        "skip_tags": [
                            "LDR"
                        ],
                        "tag_aliases": [
                            {
                                "code": "a",
                                "from_tag": "FMT",
                                "tag": "990"
                            },
                            {
                                "code": null,
                                "from_tag": "MZK",
                                "tag": "991"
                            }
                        ],
                        "issue_mapping": {
                            "barcode": "b",
                            "bundle": "i",
                            "issuance_type": "s",
                            "tag": "996",
                            "volume_number": "v",
                            "volume_year": "y"
                        },
                        "ignore_unknown_tags": true,
                        "mrc_encoding": "utf-8",
                        "mandatory_fields": [
                            "001",
                            "005",
                            "008"
                        ]
                    }
                }
            },
            "required": [
                "host",
                "endpoint",
                "base",
                "system_number_pattern",
                "oai_identifier_template"
            ],
            "title": "AlephOAIConfig",
            "type": "object"
        },
        "MarcContext": {
            "properties": {
                "skip_tags": {
                    "default": [
                        "LDR"
                    ],
                    "items": {
                        "type": "string"
                    },
                    "title": "Skip Tags",
                    "type": "array"
                },
                "tag_aliases": {
                    "default": [
                        {
                            "from_tag": "FMT",
                            "tag": "990",
                            "code": "a"
                        },
                        {
                            "from_tag": "MZK",
                            "tag": "991",
                            "code": null
                        }
                    ],
                    "items": {
                        "$ref": "#/$defs/TagAlias"
                    },
                    "title": "Tag Aliases",
                    "type": "array"
                },
                "issue_mapping": {
                    "$ref": "#/$defs/MarcIssueMapping",
                    "default": {
                        "tag": "996",
                        "barcode": "b",
                        "issuance_type": "s",
                        "volume_number": "v",
                        "volume_year": "y",
                        "bundle": "i"
                    }
                },
                "ignore_unknown_tags": {
                    "default": true,
                    "title": "Ignore Unknown Tags",
                    "type": "boolean"
                },
                "mrc_encoding": {
                    "default": "utf-8",
                    "title": "Mrc Encoding",
                    "type": "string"
                },
                "mandatory_fields": {
                    "default": [
                        "001",
                        "005",
                        "008"
                    ],
                    "items": {
                        "pattern": "^\\d{3}$",
                        "type": "string"
                    },
                    "title": "Mandatory Fields",
                    "type": "array"
                }
            },
            "title": "MarcContext",
            "type": "object"
        },
        "MarcIssueMapping": {
            "description": "Defines the mapping of MARC issue-related fields and subfields.",
            "properties": {
                "tag": {
                    "pattern": "^\\d{3}$",
                    "title": "Tag",
                    "type": "string",
                    "default": "996"
                },
                "barcode": {
                    "pattern": "^[a-zA-Z0-9]$",
                    "title": "Barcode",
                    "type": "string",
                    "default": "b"
                },
                "issuance_type": {
                    "pattern": "^[a-zA-Z0-9]$",
                    "title": "Issuance Type",
                    "type": "string",
                    "default": "s"
                },
                "volume_number": {
                    "anyOf": [
                        {
                            "pattern": "^[a-zA-Z0-9]$",
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": "v",
                    "title": "Volume Number"
                },
                "volume_year": {
                    "anyOf": [
                        {
                            "pattern": "^[a-zA-Z0-9]$",
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": "y",
                    "title": "Volume Year"
                },
                "bundle": {
                    "anyOf": [
                        {
                            "pattern": "^[a-zA-Z0-9]$",
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": "i",
                    "title": "Bundle"
                }
            },
            "required": [
                "tag",
                "barcode",
                "issuance_type"
            ],
            "title": "MarcIssueMapping",
            "type": "object"
        },
        "TagAlias": {
            "properties": {
                "from_tag": {
                    "title": "From Tag",
                    "type": "string"
                },
                "tag": {
                    "pattern": "^\\d{3}$",
                    "title": "Tag",
                    "type": "string"
                },
                "code": {
                    "anyOf": [
                        {
                            "pattern": "^[a-zA-Z0-9]$",
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "title": "Code"
                }
            },
            "required": [
                "from_tag",
                "tag"
            ],
            "title": "TagAlias",
            "type": "object"
        }
    },
    "properties": {
        "clients": {
            "items": {
                "$ref": "#/$defs/AlephOAIConfig"
            },
            "title": "Clients",
            "type": "array"
        }
    },
    "required": [
        "clients"
    ],
    "title": "CatalogSettings",
    "type": "object"
}