{
    "$defs": {
        "IntiimComparatorConfig": {
            "properties": {
                "ollama_url": {
                    "default": "http://localhost:11434",
                    "title": "Ollama Url",
                    "type": "string"
                },
                "llm_enabled": {
                    "default": true,
                    "title": "Llm Enabled",
                    "type": "boolean"
                },
                "nonstandard_llm_enabled": {
                    "default": false,
                    "title": "Nonstandard Llm Enabled",
                    "type": "boolean"
                },
                "valid_threshold": {
                    "default": 6,
                    "minimum": 0,
                    "maximum": 30,
                    "title": "Valid Max",
                    "type": "integer"
                },
                "warning_threshold": {
                    "default": 12,
                    "minimum": 0,
                    "maximum": 30,
                    "title": "Warning Max",
                    "type": "integer"
                }
            },
            "title": "IntiimComparatorConfig",
            "type": "object"
        }
    },
    "properties": {
        "intiim": {
            "anyOf": [
                {
                    "$ref": "#/$defs/IntiimComparatorConfig"
                },
                {
                    "type": "null"
                }
            ],
            "default": {
                "ollama_url": "http://localhost:11434",
                "llm_enabled": true,
                "nonstandard_llm_enabled": false,
                "valid_threshold": 6,
                "warning_threshold": 12
            }
        }
    },
    "title": "ComparisonSettings",
    "type": "object"
}
